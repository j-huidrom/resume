{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "huidrom-labs",
  "main": "./src/worker.js",
  "compatibility_date": "2026-10-16",
  "vars": {
    "OPENAI_MODEL": "gpt-5.5"
  },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  }
}
